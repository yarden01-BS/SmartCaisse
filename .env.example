# Single environment file for the whole project (backend + local fingerprint agent).
# Copy to .env at the repository root: cp .env.example .env

# ---------------------------------------------------------------------------
# Database (Docker / backend)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL='postgresql+psycopg2://postgres:postgres@localhost:5432/postgres'
ASYNC_DATABASE_URL='postgresql+asyncpg://postgres:postgres@localhost:5432/postgres'

# ---------------------------------------------------------------------------
# Authentication / JWT (backend)
# ---------------------------------------------------------------------------
SECRET_KEY='dev-only-secret-change-me-please-replace'
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
CORS_ORIGINS='http://localhost:5173'

# ---------------------------------------------------------------------------
# Fingerprint agent (backend + local Windows agent)
# AGENT_API_KEY and TEMPLATE_KEY must match between both sides.
# ---------------------------------------------------------------------------
AGENT_API_KEY=''
TEMPLATE_KEY=''
ENROLL_EXPIRES_MINUTES=2
BACKEND_URL=http://localhost:8000
POLL_INTERVAL=2
UFSCANNER_DLL=./UFScanner.dll
